<?xml version="1.0" encoding="utf-8"?>
<openerp>
    <data>

        <record model='ir.ui.view' id='report_asistencia_economica_form'>
            <field name="name">report.asistencia.economica</field>
            <field name="model">report.asistencia.economica</field>
            <field name="arch" type="xml">
                <form string="Asistencia Economica">
                    <sheet>
                        <group col="4">
                            <field name="fecha_inicial"/>
                            <field name="fecha_final"/>
                        </group>
                        <group>
                            <field name="paciente_ids" widget="many2many_tags"/>
                        </group>

                    </sheet>
                    <footer>
                        <button name="check_report" string="Print" type="object" default_focus="1"
                                class="oe_highlight"/>
                        or
                        <button string="Cancel" class="oe_link" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="asistencia_economica_action" model="ir.actions.act_window">
            <field name="name">Asistencia Economica</field>
            <field name="res_model">report.asistencia.economica</field>
            <field name="view_type">form</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <menuitem name="Asistencia Economica" parent="menu_reportes" id="menu_asistencia_Economica"
                  action="asistencia_economica_action"/>

        <report
                id="menu_report_asistencia_Economica"
                model="report.asistencia.economica"
                string="Asistencia Economica"
                report_type="qweb-html"
                name="consultas_pnc.report_asistencia_economica"
                menu="False"
        />

        <template id="consultas_pnc.report_asistencia_economica">
            <div class="page" align="center">

                <t t-call="consultas_pnc.styles"/>

                <t t-if="not o or not 'company_id' in o">
                    <t t-set="company" t-value="res_company"></t>
                </t>
                <div>
                    <img t-if="company.logo" t-att-src="'data:image/png;base64,%s' % company.logo"
                         style="max-height: 45px;"/>
                </div>
                <h3>Patronato Nacional de Ciegos, INC</h3>
                Asistencia Economica
                <p>Desde
                    <t t-esc="time.strftime('%d-%m-%Y',time.strptime(docs.fecha_inicial,'%Y-%m-%d'))"/>
                    hasta
                    <t t-esc="time.strftime('%d-%m-%Y',time.strptime(docs.fecha_final,'%Y-%m-%d'))"/>
                </p>

                <t t-set='asistencias_ids' t-value="docs.get_asistencias()"/>
                <t t-foreach="asistencias_ids" t-as="asistencia">
                    <t t-foreach="asistencia" t-as="o">
                        <table width="100%" class="tg">
                            <tr>
                                <th colspan="5" class="tg-yw4l">
                                    <span t-field="o.display_name"/>
                                </th>
                            </tr>
                            <tr>
                                <th class="tg-yw4l" colspan="2">Patrocinador</th>
                                <th class="tg-yw4l">Concepto</th>
                                <th class="tg-yw4l">Monto</th>
                                <th class="tg-yw4l">Fecha Ayuda</th>
                            </tr>
                            <t t-set='count' t-value='1'/>
                            <t t-set="total" t-value="0"/>
                            <t t-foreach="asistencia.get(o)" t-as="asistencia_id">
                                <t t-if="(count%2) == 1">
                                    <t t-set="cl" t-value="'tg-6k2t'"/>
                                </t>
                                <t t-if="(count%2) != 1">
                                    <t t-set="cl" t-value="'tg-yw4l'"/>
                                </t>
                                <tr>
                                    <td>
                                        <t t-esc="count"/>
                                    </td>
                                    <td t-att-class='cl'>
                                        <p t-esc="asistencia_id.name.name"/>
                                    </td>
                                    <td t-att-class='cl'>
                                        <p t-esc="asistencia_id.parentesco.name"/>
                                    </td>
                                    <td t-att-class='cl'>
                                        <p t-esc="asistencia_id.monto"/>
                                    </td>
                                    <td t-att-class='cl'>
                                        <p t-esc="asistencia_id.fecha"/>
                                    </td>
                                </tr>
                                <t t-set='count' t-value='count+1'/>
                                <t t-set="total" t-value="total + asistencia_id.monto"/>
                            </t>
                            <tr>
                                <th class="tg-yw4l" colspan="3">Totales</th>
                                <th class="tg-yw4l" colspan="2">
                                    <t t-esc="total"/>
                                </th>
                            </tr>
                        </table>
                        <br/>
                        <br/>
                    </t>
                </t>
            </div>
        </template>

    </data>
</openerp>