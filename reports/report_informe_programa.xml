<?xml version="1.0" encoding="utf-8"?>
<openerp>
    <data>
        <report
                id="menu_report_programa"
                model="informe.report.programa"
                string="Informe por Programa"
                report_type="qweb-html"
                name="consultas_pnc.report_programa"
                menu="False"
        />

        <template id="consultas_pnc.report_programa">
            <div class="page" align="center">

                <t t-call="consultas_pnc.styles"/>

                <t t-if="not o or not 'company_id' in o">
                    <t t-set="company" t-value="res_company"></t>
                </t>
                <div>
                    <img t-if="company.logo" t-att-src="'data:image/png;base64,%s' % company.logo"
                         style="max-height: 45px;"/>
                </div>
                <h3>Patronato Nacional de Ciegos, INC</h3>
                Estadistica por Programa
                Informe General
                <p>Desde
                    <t t-esc="time.strftime('%d-%m-%Y',time.strptime(docs.fecha_inicial,'%Y-%m-%d'))"/>
                    hasta
                    <t t-esc="time.strftime('%d-%m-%Y',time.strptime(docs.fecha_final,'%Y-%m-%d'))"/>
                </p>
                <t t-foreach="docs.programa_ids" t-as="programa">
                    <table width="100%" class="tg">
                        <t t-set="acumulado_mes" t-value="0"/>
                        <t t-set="acumulado_ano" t-value="0"/>
                        <t t-set="proyeccion_mes" t-value="0"/>
                        <t t-set="proyeccion_ano" t-value="0"/>
                        <t t-set="porcentaje_mes" t-value="0.0"/>
                        <t t-set="porcentaje_ano" t-value="0.0"/>
                        <t t-if="docs.programa_ids">
                            <t t-set='consulta_ids' t-value="docs.get_consultas(programa.id)"/>
                            <t t-if="len(consulta_ids[0]) > 0">
                                <tr>
                                    <th class="tg-yw4l" colspan="7">
                                        <span t-field="programa.name"/>
                                    </th>
                                </tr>
                                <tr>
                                    <th class="tg-yw4l" rowspan="2">Departamento y/o Servicio</th>
                                    <th class="tg-yw4l-2" colspan="2">Acumulado</th>
                                    <th class="tg-yw4l-2" colspan="2">Proyección</th>
                                    <th class="tg-yw4l-2" colspan="2">Porcentaje</th>
                                </tr>
                                <tr>
                                    <th class="tg-yw4l-3">Mes</th>
                                    <th class="tg-yw4l-3">Año</th>
                                    <th class="tg-yw4l-3">Mes</th>
                                    <th class="tg-yw4l-3">Año</th>
                                    <th class="tg-yw4l-3">Mes</th>
                                    <th class="tg-yw4l-3">Año</th>
                                </tr>
                                <t t-set='count' t-value='1'/>
                                <t t-foreach="consulta_ids" t-as="o">
                                    <t t-foreach="o" t-as="obj">
                                        <t t-if="programa.id == obj[2]">
                                            <t t-if="(count%2) == 1">
                                                <t t-set="cl" t-value="'tg-6k2t'"/>
                                            </t>
                                            <t t-if="(count%2) != 1">
                                                <t t-set="cl" t-value="'tg-yw4l'"/>
                                            </t>
                                            <tr>
                                                <td t-att-class='cl'>
                                                    <p t-esc="obj[0]"/>
                                                </td>
                                                <td t-att-class='cl'>
                                                    <p t-esc="obj[1]"/>
                                                </td>
                                                <td t-att-class='cl'>
                                                    <p t-esc="obj[4]"/>
                                                </td>
                                                <td t-att-class='cl'>
                                                    <p t-esc="obj[6]"/>
                                                </td>
                                                <td t-att-class='cl'>
                                                    <p t-esc="obj[5]"/>
                                                </td>
                                                <td t-att-class='cl'>
                                                    <t t-if="obj[6] > 0 and obj[1] > 0">
                                                        <span t-esc="'{:,.2f}'.format((float(obj[1]) / float(obj[6]))*100)"/>
                                                        %
                                                        <t t-set="porcentaje_mes"
                                                           t-value="porcentaje_mes + float(((float(obj[1]) / float(obj[6]))*100))"/>
                                                    </t>
                                                    <t t-if="obj[6] &lt;= 0 or obj[1] &lt;= 0">
                                                        0 %
                                                    </t>
                                                </td>
                                                <td t-att-class='cl'>
                                                    <t t-if="obj[5] > 0 and obj[4] > 0">
                                                        <span t-esc="'{:,.2f}'.format((float(obj[4]) / float(obj[5]))*100)"/>
                                                        %
                                                        <t t-set="porcentaje_ano"
                                                           t-value="porcentaje_ano + float(((float(obj[4]) / float(obj[5]))*100))"/>
                                                    </t>
                                                    <t t-if="obj[5] &lt;= 0 or obj[4] &lt;= 0">
                                                        0 %
                                                    </t>
                                                </td>
                                            </tr>
                                        </t>
                                        <t t-set='count' t-value='count+1'/>
                                        <t t-set="acumulado_mes" t-value="acumulado_mes + int(obj[1] or 0)"/>
                                        <t t-set="acumulado_ano" t-value="acumulado_ano + int(obj[4] or 0)"/>
                                        <t t-set="proyeccion_mes"
                                           t-value="proyeccion_mes + int(obj[6] or 0)"/>
                                        <t t-set="proyeccion_ano"
                                           t-value="proyeccion_ano + int(obj[5] or 0)"/>
                                    </t>
                                </t>
                            </t>

                            <tr>
                                <th class="tg-yw4l">Totales</th>
                                <th class="tg-yw4l">
                                    <t t-esc="acumulado_mes"/>
                                </th>
                                <th class="tg-yw4l">
                                    <t t-esc="acumulado_ano"/>
                                </th>
                                <th class="tg-yw4l">
                                    <t t-esc="proyeccion_mes"/>
                                </th>
                                <th class="tg-yw4l">
                                    <t t-esc="proyeccion_ano"/>
                                </th>
                                <th class="tg-yw4l">
                                    <t t-esc="'{:,.2f}'.format(float(porcentaje_mes))"/>
                                    %
                                </th>
                                <th class="tg-yw4l">
                                    <t t-esc="'{:,.2f}'.format((porcentaje_ano))"/>
                                    %
                                </th>
                            </tr>
                        </t>
                    </table>
                    <br/>
                    <br/>
                </t>
            </div>
        </template>
    </data>
</openerp>