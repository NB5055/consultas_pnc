<?xml version="1.0" encoding="utf-8"?>
<openerp>
    <data>
        <report
            id="menu_report_proyeccion"
            model="proyeccion.report.programa"
            string="Proyeccion por Programa"
            report_type="qweb-html"
            name="consultas_pnc.report_proyeccion"
            menu="False"
        />

        <template id="consultas_pnc.report_proyeccion">
            <div class="page" align="center">
                <t t-if="not o or not 'company_id' in o">
                    <t t-set="company" t-value="res_company"></t>
                </t>
                <t t-call="consultas_pnc.styles"/>
                <div>
                    <img t-if="company.logo" t-att-src="'data:image/png;base64,%s' % company.logo" style="max-height: 45px;"/>
                </div>
                <h3>Patronato Nacional de Ciegos, INC</h3>
                Estadistica por Programa
                <p><t t-esc="docs.month_string"/> / <t t-esc="docs.year"/></p>

                <t t-if="docs.programa_ids">
                    <t t-foreach="docs.programa_ids" t-as="programa">
                        <table class="tg">
                            <t t-set='consulta_ids' t-value="docs.get_consultas(programa.id)"/>
                            <t t-if="len(consulta_ids[0]) > 0">
                                <tr >
                                    <th colspan="7" class="tg-yw4l">
                                        <span t-field="programa.name"/>
                                    </th>
                                </tr>
                                <tr>
                                    <th class="tg-yw4l" align="left">Departamento</th>
                                    <th class="tg-yw4l">Mes</th>
                                    <th class="tg-yw4l">Acumulado Año</th>
                                    <th class="tg-yw4l">Proyección Mes</th>
                                    <th class="tg-yw4l">Proyección Año</th>
                                    <th class="tg-yw4l">Porcentaje Mes</th>
                                    <th class="tg-yw4l">Porcentaje Año</th>
                                </tr>
                                <t t-set='count' t-value='1'/>
                                <t t-foreach="consulta_ids" t-as="obj">
                                    <t t-foreach="obj" t-as="consulta_obj">
                                        <t t-if="(count%2) == 1">
                                            <t t-set="cl" t-value="'tg-6k2t'"/>
                                        </t>
                                        <t t-if="(count%2) != 1">
                                            <t t-set="cl" t-value="'tg-yw4l'"/>
                                        </t>
                                        <tr>
                                            <td t-att-class='cl'><p t-esc="consulta_obj['description']"/></td>
                                            <td t-att-class='cl'><p t-esc="consulta_obj['month']"/></td>
                                            <td t-att-class='cl'><p t-esc="consulta_obj['year']"/></td>
                                            <td t-att-class='cl'><p t-esc="consulta_obj['proyection_month']"/></td>
                                            <td t-att-class='cl'><p t-esc="consulta_obj['proyection_year']"/></td>
                                            <td t-att-class='cl'><p t-esc="consulta_obj['percent_month']"/></td>
                                            <td t-att-class='cl'><p t-esc="consulta_obj['percent_year']"/></td>
                                        </tr>
                                        <t t-set='count' t-value='count+1'/>
                                    </t>
                                </t>
                            </t>
                        </table>
                    </t>
                </t>
            </div>
        </template>
    </data>
</openerp>