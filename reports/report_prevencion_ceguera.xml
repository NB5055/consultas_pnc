<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="menu_report_prevencion_ceguera" model="ir.actions.report">
        <field name="name">Prevencion Ceguera</field>
        <field name="model">informe.report.prevencion.ceguera</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">consultas_pnc.report_prevencion_ceguera</field>
    </record>

    <template id="report_prevencion_ceguera">
        <t t-call="web.basic_layout">
            <div class="page" align="center">

                <t t-call="consultas_pnc.styles"/>

                <t t-set="company" t-value="res_company"/>
                <div>
                    <img t-if="company.logo" t-att-src="image_data_uri(company.logo)"
                         style="max-height: 45px;"/>
                </div>
                <h3>Patronato Nacional de Ciegos, INC</h3>
                Informe Prevencion Ceguera
                <p>Desde
                    <p>Desde <t t-out="docs.fecha_inicial.strftime('%d-%m-%Y')"/> hasta <t t-out="docs.fecha_final.strftime('%d-%m-%Y')"/></p>
                </p>

                <table width="100%" class="tg">
                    <t t-foreach="docs.get_data()" t-as="programa">
                        <tr>
                            <th class="tg-yw4l" align="center" colspan="3">
                                <span t-out="programa['programa']"/>
                            </th>
                        </tr>
                        <tr>
                            <th class="tg-yw4l" align="left">Operativo</th>
                            <th class="tg-yw4l">Realizados</th>
                            <th class="tg-yw4l">Personas Atendidas</th>
                        </tr>
                        <t t-set='count' t-value='1'/>
                        <t t-foreach="programa['data']" t-as="data">
                            <t t-if="(count%2) == 1">
                                <t t-set="cl" t-value="'tg-6k2t'"/>
                            </t>
                            <t t-if="(count%2) != 1">
                                <t t-set="cl" t-value="'tg-yw4l'"/>
                            </t>
                            <tr>
                                <td t-att-class='cl'>
                                    <p t-out="data[0]"/>
                                </td>
                                <td t-att-class='cl'>
                                    <p t-out="data[1]"/>
                                </td>
                                <td t-att-class='cl'>
                                    <p t-out="data[2]"/>
                                </td>
                            </tr>
                        </t>
                        <t t-set='count' t-value='count+1'/>
                    </t>
                </table>
            </div>
        </t>
    </template>
</odoo>
