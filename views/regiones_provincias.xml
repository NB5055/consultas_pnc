<?xml version="1.0" encoding="UTF-8"?>
<odoo>
<!--========================================================================-->
    <!-- View Regiones y Provincias-->
<!--========================================================================-->
    <record model='ir.actions.act_window' id='region_region_act'>
        <field name="name">Regiones</field>
        <field name="res_model">region.region</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
          <p class="o_view_nocontent_smiling_face">
            Haga Click Para Crear Nueva Region.
          </p>
        </field>
    </record>

    <record model='ir.actions.act_window' id='region_subregion_act'>
        <field name="name">Sub-Regiones</field>
        <field name="res_model">region.subregion</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
          <p class="o_view_nocontent_smiling_face">
            Haga Click Para Crear Nueva Sub-Region.
          </p>
        </field>
    </record>

    <record model='ir.actions.act_window' id='region_provincia_act'>
        <field name="name">Provincias</field>
        <field name="res_model">region.provincia</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
          <p class="o_view_nocontent_smiling_face">
            Haga Click Para Crear Nueva Provincia.
          </p>
        </field>
    </record>
</odoo>
