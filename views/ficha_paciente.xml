            <field name="model">ficha.paciente.ayuda.economica</field>
            <field name="arch" type="xml">
                <tree string="Ayuda economica Pacientes">
                    <field name="ayuda_economica_id" string="Beneficiario"/>
                    <field name="name" string="Patrocinador"/>
                    <field name="parentesco" string="Tipo"/>
                    <field name="monto"/>
                    <field name="fecha"/>
                </tree>
