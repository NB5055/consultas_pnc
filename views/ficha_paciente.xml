<?xml version="1.0" encoding="UTF-8"?>
<openerp>
    <data>
<!--========================================================================-->
    <!-- View Formulario Ficha -->
<!--========================================================================-->
        <record model='ir.ui.view' id='ficha_paciente_form'>
            <field name="name">Formulario Paciente / Participantes</field>
            <field name="model">ficha.paciente</field>
            <field name="arch" type="xml">
                <form string="Ficha PAcientes / Participantes">
                    <header>
                        <field name="state" clickable="True" widget="statusbar" statusbar_colors='{"activo":"green","inactivo":"red"}'/>
                    </header>
                    <sheet>
                        <field name="image" widget='image' class="oe_avatar" options='{"preview_image": "image_medium"}'/>
                        <div class="oe_title">
                            <h1>
                                <field name="nombre" default_focus="1" placeholder="Nombre del paciente" />
                            </h1>
                            <h1>
                                <field name="apellidos" placeholder="Apellidos del paciente" />
                            </h1>
                            <h3>
                                <field name="name" placeholder="Cedula del paciente"/>
                            </h3>
                        </div>
                        <group>
                            <field name="programa"/>
                        </group>
                        <notebook >
                            <page string="Basicos y Contacto">
                                <group string="Basicos" col="4">
                                    <group col="2">
                                        <field name="apodos" placeholder="Apodos"/>
                                        <field name="sexo" />
                                        <field name="grado_academico" placeholder="Grado Academico"/>
                                        <field name="trabajo" placeholder="Trabajo"/>
                                        <field name="lugar_nacimiento" placeholder="Lugad de Nacimíento"/>
                                    </group>
                                    <group col="2">
                                        <field name="edad" placeholder="Edad"/>
                                        <field name="estado_civil"/>
                                        <field name="vehiculo"/>
                                        <field name="seguro" placeholder="Seguro"/>
                                    </group>
                                </group>
                                <group>
                                    <field name="enfermedades" required="1" string="Condicion" nolabel="1">
                                        <tree editable="top" >
                                            <field name="name" string="Condicion" options="{'no_create_edit': True}"/>
                                        </tree>
                                    </field>
                                    <field name="diagnostico" colspan="4" nolabel="1">
                                        <tree editable="top" colors="red:True" style="background-color:red">
                                            <field name="name" string="Diagnostico" options="{'no_create_edit': True}"/>
                                        </tree>
                                    </field>
                                </group>

                                <group string="Contacto">
                                    <field name="direccion"
                                                placeholder="Direccíon"/>
                                    <div colspan="2">
                                        <field name="telefonos" >
                                            <tree string="Telefonos del Paciente" editable="top">
                                                <field name="name" />
                                                <field name="tipo" />
                                            </tree>
                                        </field>
                                    </div>
                                </group>
                            </page>
                            <page string="Asistencia Economica">
                                <field name="ayuda_economica" >
                                    <tree string="Ayuda Economica" editable="top">
                                        <field name="name" string="Patrocinador"/>
                                        <field name="parentesco" string="Concepto"/>
                                        <field name="monto" type="char"/>
                                        <field name="fecha"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Vivienda y Familiares">
                                <group>
                                    <field name="hijos" />
                                    <field name="cohabitantes" />
                                    <field name="vivienda" />
                                </group>
                            </page>
                            <page string="Historial">
                                <field name="consultas">
                                    <tree>
                                        <field name="fecha"/>
                                        <field name="programa"/>
                                        <field name="diagnostico"/>
                                        <field name="tratamiento"/>
                                        <field name="referimiento"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers" groups="base.group_user"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>

        <record model='ir.ui.view' id='ficha_paciente_tree'>
            <field name="name">Lista Pacientes / Participantes</field>
            <field name="model">ficha.paciente</field>
            <field name="arch" type="xml">
                <tree string="Ficha Pacientes">
                    <field name="name" />
                    <field name="nombre" />
                    <field name="apellidos" />
                    <field name="apodos" />
                    <field name="edad" />
                    <field name="direccion" />
                </tree>
            </field>
        </record>

        <record model='ir.ui.view' id='ficha_paciente_kanban'>
            <field name="name">Pacientes / Participantes</field>
            <field name="model">ficha.paciente</field>
            <field name="arch" type="xml">
                <kanban>
                    <field name="name" />
                    <field name="nombre" />
                    <field name="apellidos" />
                    <field name="programa"/>
                    <field name="consultas"/>

                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_global_click">
                                <div class="o_kanban_image">
                                    <img t-att-src="kanban_image('paciente.paciente', 'image_small', record.id.value)"/>
                                </div>
                                <div class="oe_kanban_details">
                                    <strong>
                                        <field name="apellidos"/> <field name="nombre"/>
                                        <br/>
                                        <field name="name"/>
                                        <br/>
                                        <field name="programa"/>
                                    </strong>
                                    <ul>
                                        <li>
                                            <t>Consultas : <field name="consultas"/></t>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record model='ir.ui.view' id='ficha_paciente_search'>
            <field name="name">Buscar Paciente / Participante</field>
            <field name="model">ficha.paciente</field>
            <field name="arch" type="xml">
                <search string="Ficha Pacientes" >
                    <field name="name" />
                    <field name="nombre" />
                    <field name="apellidos" />
                    <field name="apodos" />
                    <field name="lugar_nacimiento" />
                    <field name="enfermedades" />

                    <group expand="0" string="Group By">
                        <filter string="Nombre" domain="" context="{'group_by':'nombre'}"/>
                        <filter string="Apellidos" domain="" context="{'group_by':'apellidos'}"/>
                        <filter string="Programa" domain="" context="{'group_by':'programa'}"/>
                        <filter string="Sexo" domain="" context="{'group_by':'sexo'}"/>
                        <filter string="Edad" domain="" context="{'group_by':'edad'}"/>
                        <filter string="Estado Civil" domain="" context="{'group_by':'estado_civil'}"/>
                        <filter string="Lugar de Nacimiento" context="{'group_by':'lugar_nacimiento'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record model='ir.actions.act_window' id='ficha_paciente_act'>
            <field name="name">Pacientes / Participantes </field>
            <field name="res_model">ficha.paciente</field>
            <field name="view_type">form</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="help" type="html">
              <p class="oe_view_nocontent_create">
                Haga Click Para Crear un Nuevo paciente.
              </p>
            </field>
        </record>

