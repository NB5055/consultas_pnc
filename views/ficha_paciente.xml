<?xml version="1.0" encoding="UTF-8"?>
<odoo>
<!--========================================================================-->
    <!-- View Formulario Ficha -->
<!--========================================================================-->
    <record model='ir.ui.view' id='ficha_paciente_form'>
        <field name="name">Formulario Paciente / Participantes</field>
        <field name="model">ficha.paciente</field>
        <field name="arch" type="xml">
            <form string="Ficha PAcientes / Participantes">
                <header>
                    <field name="state" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="show_complete_history" type="object" class="oe_stat_button" icon="fa-archive">
                            <field name="consultas_count" string="Historial" widget="statinfo"/>
                        </button>
                        <button name="show_citas" type="object" class="oe_stat_button" icon="fa-calendar">
                            <field name="citas_count" string="Citas" widget="statinfo"/>
                        </button>
                    </div>

                    <field name="image" widget='image' class="oe_avatar" options='{"preview_image": "image_128"}'/>
                    <div class="oe_title">
                        <h1>
                            <field name="nombre" default_focus="1" placeholder="Nombre del paciente" />
                        </h1>
                        <h1>
                            <field name="apellidos" placeholder="Apellidos del paciente" />
                        </h1>
                        <h3>
                            <field name="name" placeholder="Cedula del paciente"/>
                        </h3>
                    </div>
                    <group>
                        <field name="programa"/>
                    </group>
                    <notebook >
                        <page string="Basicos y Contacto">
                            <group string="Basicos" col="4">
                                <group col="2">
                                    <field name="apodos" placeholder="Apodos"/>
                                    <field name="sexo" />
                                    <field name="grado_academico" placeholder="Grado Academico"/>
                                    <field name="trabajo" placeholder="Trabajo"/>
                                    <field name="lugar_nacimiento" placeholder="Lugad de Nacimíento"/>
                                </group>
                                <group col="2">
                                    <field name="birth_date"/>
                                    <field name="edad" readonly="1"/>
                                    <field name="estado_civil"/>
                                    <field name="vehiculo"/>
                                    <field name="seguro" placeholder="Seguro"/>
                                </group>
                            </group>
                            <group>
                                <field name="enfermedades" required="1" string="Condicion" nolabel="1">
                                    <list editable="top" decoration-danger="1">
                                        <field name="name" string="Condicion" required="1"
                                               options="{'no_create_edit': True,
                                                         'no_create': True}"/>
                                    </list>
                                </field>
                                <field name="diagnostico" colspan="4" nolabel="1">
                                    <list editable="top" decoration-danger="1">
                                        <field name="name" string="Diagnostico" required="1" options="{'no_create_edit': True,
                                                         'no_create': True}"/>
                                    </list>
                                </field>
                            </group>

                            <group string="Contacto">
                                <field name="direccion"
                                            placeholder="Direccíon"/>
                                <div colspan="2">
                                    <field name="telefonos" >
                                        <list string="Telefonos del Paciente" editable="top">
                                            <field name="name" />
                                            <field name="tipo" />
                                        </list>
                                    </field>
                                </div>
                            </group>
                        </page>
                        <page string="Asistencia Economica">
                            <field name="ayuda_economica" >
                                <list string="Ayuda Economica" editable="top">
                                    <field name="name" string="Patrocinador" options="{'no_create_edit': True,
                                                         'no_create': True}"/>
                                    <field name="parentesco" string="Concepto" options="{'no_create_edit': True,
                                                         'no_create': True}"/>
                                    <field name="monto"/>
                                    <field name="fecha"/>
                                </list>
                            </field>
                        </page>
                        <page string="Vivienda y Familiares">
                            <group>
                                <field name="hijos" />
                                <field name="cohabitantes" />
                                <field name="vivienda" />
                                <field name="renta" invisible="vivienda != 'a'"/>
                            </group>
                            <group string="Ingresos y Gastos Fijos">
                                <group>
                                    <field name="ingresos"/>
                                    <field name="otros"/>
                                </group>
                                <field name="gastos_fijos" nolabel="1" colspan="2">
                                    <list string="Gastos Fijos" editable="bottom">
                                        <field name="name" options="{'no_create_edit': True, 'no_create': True}"/>
                                        <field name="monto" sum="Total"/>
                                    </list>
                                </field>
                            </group>
                        </page>
                        <!--<page string="Historial">-->
                            <!--<field name="consultas">-->
                                <!--<list>-->
                                    <!--<field name="fecha"/>-->
                                    <!--<field name="programa"/>-->
                                    <!--<field name="employee_id"/>-->
                                    <!--<field name="tratamiento"/>-->
                                <!--</list>-->
                            <!--</field>-->
                        <!--</page>-->
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record model='ir.ui.view' id='ficha_paciente_tree'>
        <field name="name">Lista Pacientes / Participantes</field>
        <field name="model">ficha.paciente</field>
        <field name="arch" type="xml">
            <list string="Ficha Pacientes">
                <field name="name" />
                <field name="nombre" />
                <field name="apellidos" />
                <field name="apodos" />
                <field name="birth_date"/>
                <field name="edad"/>
                <field name="direccion" />
            </list>
        </field>
    </record>

    <record model='ir.ui.view' id='ficha_paciente_kanban'>
        <field name="name">Pacientes / Participantes</field>
        <field name="model">ficha.paciente</field>
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <t t-name="card" class="flex-row">
                        <aside class="o_kanban_aside_full">
                            <field name="image_128" widget="image" alt="Paciente"/>
                        </aside>
                        <main class="ms-2">
                            <strong>
                                <field name="apellidos"/> <field name="nombre"/>
                                <br/>
                                <field name="name"/>
                                <br/>
                                <field name="programa"/>
                            </strong>
                            <div>
                                <strong>Nacimiento : </strong> <field name="birth_date"/> (<field name="edad"/>)
                            </div>
                            <ul>
                                <li>
                                    <t>Consultas : <field name="consultas_count"/></t>
                                </li>
                            </ul>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record model='ir.ui.view' id='ficha_paciente_search'>
        <field name="name">Buscar Paciente / Participante</field>
        <field name="model">ficha.paciente</field>
        <field name="arch" type="xml">
            <search string="Ficha Pacientes" >
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('cedula_digitos', 'ilike', self)]"/>
                <field name="nombre" />
                <field name="apellidos" />
                <field name="apodos" />
                <field name="lugar_nacimiento" />
                <field name="enfermedades" />
                <field name="edad"/>
                <field name="birth_date"/>
                <field name="programa"/>
                <filter name="filter_activo" string="Activos" domain="[('state', '=', 'activo')]"/>
                <filter name="filter_inactivo" string="Inactivos" domain="[('state', '=', 'inactivo')]"/>
                <separator/>
                <filter name="filter_cedula_repetida" string="Cedula Repetida"
                        domain="[('cedula_repetida', '=', True)]"/>
                <filter name="filter_sin_cedula" string="Sin Cedula" domain="[('name', '=', '0')]"/>
                <filter name="filter_sin_nacimiento" string="Sin Fecha de Nacimiento"
                        domain="[('birth_date', '=', False)]"/>

                <group>
                    <filter name="group_cedula" string="Cedula" context="{'group_by':'name'}"/>
                    <filter name="group_nombre" string="Nombre" context="{'group_by':'nombre'}"/>
                    <filter name="group_apellidos" string="Apellidos" context="{'group_by':'apellidos'}"/>
                    <filter name="group_programa" string="Programa" context="{'group_by':'programa'}"/>
                    <filter name="group_sexo" string="Sexo" context="{'group_by':'sexo'}"/>
                    <filter name="group_edad" string="Edad" context="{'group_by':'edad'}"/>
                    <filter name="group_birth_date" string="Nacimiento" context="{'group_by':'birth_date'}"/>
                    <filter name="group_estado_civil" string="Estado Civil" context="{'group_by':'estado_civil'}"/>
                    <filter name="group_lugar_nacimiento" string="Lugar de Nacimiento" context="{'group_by':'lugar_nacimiento'}"/>
                </group>
            </search>
        </field>
    </record>

    <record model='ir.actions.act_window' id='ficha_paciente_act'>
        <field name="name">Pacientes / Participantes </field>
        <field name="res_model">ficha.paciente</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
          <p class="o_view_nocontent_smiling_face">
            Haga Click Para Crear un Nuevo paciente.
