<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="operativo_form" model="ir.ui.view">
        <field name="name">Prevencion de Ceguera</field>
        <field name="model">operativos</field>
        <field name="arch" type="xml">
            <form string="Prevencion de Ceguera">
                <sheet>
                    <group>
                        <field name="name" domain="[('category','=','pc')]"/>
                        <field name="atendidos"/>
                        <field name="fecha"/>
                        <field name="programa" required="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="operativo_tree" model="ir.ui.view">
        <field name="name">Prevencion de Ceguera</field>
        <field name="model">operativos</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="atendidos"/>
                <field name="fecha"/>
                <field name="programa"/>
            </list>
        </field>
    </record>

    <record id="operativo_act" model="ir.actions.act_window">
        <field name="name">Prevencion de Ceguera</field>
        <field name="res_model">operativos</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
